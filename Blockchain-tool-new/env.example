# Copy this file to .env and fill in real values for LOCAL use only.
# On Render, you set these as actual Environment Variables in the
# Dashboard (or via render.yaml's envVars prompts) instead - Render
# does not read a .env file from your repo.
#
# NEVER commit a real .env file - it's already excluded in .gitignore.

# Required - protects every API endpoint. Make up any long random string.
TOOLKIT_API_KEY=change-me-to-a-long-random-string

# Required for checking/tracing Ethereum wallets. Get a free key at
# https://etherscan.io/apis (Bitcoin and XRP wallets don't need this).
ETHERSCAN_API_KEY=change-me-to-your-real-etherscan-key

# Recommended once deployed somewhere reachable over the network -
# restricts which websites can call this API from a browser.
# Leave unset for local testing (defaults to wide open, with a
# startup warning). Set to your real deployed URL once you have one:
TOOLKIT_ALLOWED_ORIGINS=https://your-app.onrender.com

# Only needed if the local filesystem where this runs is EPHEMERAL
# (e.g. Render without a Persistent Disk attached) - points the app
# at a durable location instead. Leave unset for local use; the app
# then just uses the folder these scripts sit in.
# TOOLKIT_DATA_DIR=/var/data

# Required to log in via the web app at all - creates your first admin
# account on startup (only if that username doesn't already exist yet -
# safe to leave these set permanently, they won't overwrite a later
# password change made through the app itself).
TOOLKIT_ADMIN_USERNAME=change-me-to-your-username
TOOLKIT_ADMIN_PASSWORD=change-me-to-a-real-password-min-8-chars

# Signs login sessions - make up another long random string, different
# from TOOLKIT_API_KEY. Leave unset for quick local testing (a temporary
# one is generated each run, but everyone gets logged out on every
# restart) - set a real value before you have real users relying on
# staying logged in.
TOOLKIT_JWT_SECRET=change-me-to-a-different-long-random-string

# Session cookies are Secure (HTTPS-only) by default, which is correct
# for any real deployment. Only set this to false for local http://
# testing - browsers silently refuse to send a Secure cookie back over
# plain HTTP, which would make login appear to "not stick".
# TOOLKIT_COOKIE_SECURE=false

# Optional - lets you find your own admin account by email for "forgot
# password" purposes. Leave blank if you don't need this for the
# bootstrap admin account (you can always add an email to any account
# later through the Users panel).
TOOLKIT_ADMIN_EMAIL=

# Required for "forgot password" emails to actually send. Works with
# any standard SMTP provider - Gmail (with an app password), SendGrid,
# Mailgun, Amazon SES, Resend, etc. Leave all of these unset to disable
# email sending entirely (forgot-password requests are still accepted,
# nothing gets emailed - see email_sender.py for details).
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM_ADDRESS=noreply@yourdomain.com

# Used to build the link inside password-reset emails. Set this to
# your real deployed URL (same one you used for TOOLKIT_ALLOWED_ORIGINS).
TOOLKIT_BASE_URL=https://your-app.onrender.com

# Optional - raises TronGrid's rate limit for USDT-TRC20 (Tron) lookups.
# Works fine without one for occasional/light use.
TRON_API_KEY=

# Optional - enables the AI-assisted narrative report and pattern
# description features on Link Tracer's results (see ai_assist.py).
# Unlike everything else this app calls, THIS is the one dependency
# that costs real money per use. Get a key at console.anthropic.com.
# Leave unset to disable these two features entirely - nothing else
# in the app is affected.
ANTHROPIC_API_KEY=
